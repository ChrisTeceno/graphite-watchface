<?xml version="1.0" encoding="UTF-8"?>
<!--
  Graphite - a greyscale digital Wear OS watch face.

  Layout on the 450x450 virtual canvas (scaled to the device, so it fits both
  Pixel Watch 3 sizes: 384x384 for the 41mm and 456x456 for the 45mm):

      (no notification dot: Wear OS paints its own, low and centred)
      y=104   date, muted
      y=155   time, hh:mm, 128px
      y=318   bottom row: battery slot, weather icon + temperature,
              heart rate slot

  The palette is a single grey ramp on black. With no colour to lean on, the
  hierarchy is carried by brightness alone, so pure white is reserved for the
  one accent (the seconds arc) and the time sits a step
  below it. Everything that moves or glows is dropped in ambient.
-->
<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
    <Metadata key="PREVIEW_TIME" value="10:08:41"/>

  <!--
    Weather glyphs, indexed by [WEATHER.CONDITION] (0-15). Using a
    BitmapFont lets the enum value BE the lookup, so no Condition chain
    of sixteen branches is needed. Several codes share a glyph, and
    CLEAR/SUNNY/PARTLY_CLOUDY differ between the two sets so the night
    icons show a moon. Names 0-9 are Characters; 10-15 are two
    characters each and so must be Words.
  -->
  <BitmapFonts>
    <BitmapFont name="wx_day">
      <Character name="0" resource="wx_unknown" width="96" height="96"/>
      <Character name="1" resource="wx_sun" width="96" height="96"/>
      <Character name="2" resource="wx_cloud" width="96" height="96"/>
      <Character name="3" resource="wx_fog" width="96" height="96"/>
      <Character name="4" resource="wx_heavy_rain" width="96" height="96"/>
      <Character name="5" resource="wx_snow" width="96" height="96"/>
      <Character name="6" resource="wx_rain" width="96" height="96"/>
      <Character name="7" resource="wx_snow" width="96" height="96"/>
      <Character name="8" resource="wx_sun" width="96" height="96"/>
      <Character name="9" resource="wx_storm" width="96" height="96"/>
      <Word name="10" resource="wx_sleet" width="96" height="96"/>
      <Word name="11" resource="wx_snow" width="96" height="96"/>
      <Word name="12" resource="wx_rain" width="96" height="96"/>
      <Word name="13" resource="wx_fog" width="96" height="96"/>
      <Word name="14" resource="wx_partly_day" width="96" height="96"/>
      <Word name="15" resource="wx_wind" width="96" height="96"/>
    </BitmapFont>
    <BitmapFont name="wx_night">
      <Character name="0" resource="wx_unknown" width="96" height="96"/>
      <Character name="1" resource="wx_moon" width="96" height="96"/>
      <Character name="2" resource="wx_cloud" width="96" height="96"/>
      <Character name="3" resource="wx_fog" width="96" height="96"/>
      <Character name="4" resource="wx_heavy_rain" width="96" height="96"/>
      <Character name="5" resource="wx_snow" width="96" height="96"/>
      <Character name="6" resource="wx_rain" width="96" height="96"/>
      <Character name="7" resource="wx_snow" width="96" height="96"/>
      <Character name="8" resource="wx_moon" width="96" height="96"/>
      <Character name="9" resource="wx_storm" width="96" height="96"/>
      <Word name="10" resource="wx_sleet" width="96" height="96"/>
      <Word name="11" resource="wx_snow" width="96" height="96"/>
      <Word name="12" resource="wx_rain" width="96" height="96"/>
      <Word name="13" resource="wx_fog" width="96" height="96"/>
      <Word name="14" resource="wx_partly_night" width="96" height="96"/>
      <Word name="15" resource="wx_wind" width="96" height="96"/>
    </BitmapFont>
    <!--
      Moon phases, indexed by [MOON_PHASE_TYPE] (0-7): new, evening
      crescent, first quarter, waxing gibbous, full, waning gibbous, last
      quarter, morning crescent. Used instead of a generic moon whenever the
      night sky is clear, so the glyph matches the sky you would look up at.
    -->
    <BitmapFont name="moon_phases">
      <Character name="0" resource="moon_0" width="96" height="96"/>
      <Character name="1" resource="moon_1" width="96" height="96"/>
      <Character name="2" resource="moon_2" width="96" height="96"/>
      <Character name="3" resource="moon_3" width="96" height="96"/>
      <Character name="4" resource="moon_4" width="96" height="96"/>
      <Character name="5" resource="moon_5" width="96" height="96"/>
      <Character name="6" resource="moon_6" width="96" height="96"/>
      <Character name="7" resource="moon_7" width="96" height="96"/>
    </BitmapFont>
  </BitmapFonts>

    <Scene backgroundColor="#ff000000">

        <!-- Outer rail: the track the seconds arc runs on. -->
        <PartDraw x="0" y="0" width="450" height="450" name="rail">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Arc centerX="225" centerY="225" width="432" height="432"
                 startAngle="0" endAngle="360" direction="CLOCKWISE">
                <Stroke color="#ff1c1e22" thickness="3"/>
            </Arc>
        </PartDraw>

        <!-- Seconds: white arc sweeping from 12 o'clock. Hidden in ambient. -->
        <PartDraw x="0" y="0" width="450" height="450" name="seconds">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Arc centerX="225" centerY="225" width="432" height="432"
                 startAngle="0" endAngle="0" direction="CLOCKWISE">
                <Transform target="endAngle" value="[SECOND] * 6"/>
                <Stroke color="#ffffffff" thickness="3" cap="ROUND"/>
            </Arc>
        </PartDraw>

        <!--
          No notification dot is drawn here on purpose.

          Wear OS already paints its own unread-notification indicator over the
          watch face, low and centred, and it appears and disappears on exactly
          the same condition this face would have used. Drawing our own put two
          dots on screen at once, one top and one bottom. The system's is the
          one that stays; it is standard and needs no device settings changed.

          If you ever want the dot at the top instead, the system indicator can
          be switched off device-wide with
              adb shell settings put system unread_notification_dot_indicator 0
          but that affects every watch face, not just this one.
        -->

        <!--
          Date, e.g. "Fri 04 Sep".

          Drawn ONCE. An earlier version faux-bolded this by stacking four
          copies at 1px offsets, which did thicken the stroke but left the
          glyphs visibly blurry: every overlapping antialiased edge softens the
          one under it. A single draw at a larger size is both heavier and
          crisp, so the stroke comes from size here, not from stacking.

          Do not reintroduce offset copies. <Outline> is not an option either:
          it is silently ignored by the runtime (a width=4 outline in pure red
          rendered nothing at all), and the font's weight ladder tops out at
          BLACK, worth only ~10% over BOLD.
        -->
        <PartText x="0" y="98" width="450" height="42" name="date">
            <Variant mode="AMBIENT" target="alpha" value="130"/>
            <!-- Tapping the date opens the calendar. CALENDAR is a built-in
                 system shortcut, so this follows whatever calendar app the
                 watch resolves rather than hardcoding a package name. -->
            <Launch target="CALENDAR"/>
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="30" weight="BLACK"
                      letterSpacing="0.16" color="#ffc4ccd6">
                    <Template><![CDATA[%s %s %s]]>
                        <Parameter expression="[DAY_OF_WEEK_S]"/>
                        <Parameter expression="[DAY_Z]"/>
                        <Parameter expression="[MONTH_S]"/>
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!--
          Time, with no separator between hours and minutes. The two halves are
          separate TimeText elements butted against a 26px gutter rather than one
          element with a space in the format: a literal space in the format
          string makes the whole element render nothing at all.

          Each half is drawn twice, LIGHT for interactive and THIN and dimmer
          for ambient, swapped by alpha Variants.
        -->
        <DigitalClock x="0" y="155" width="450" height="140" name="clock">
            <TimeText format="hh" hourFormat="24" align="END"
                      x="0" y="0" width="212" height="140" alpha="255">
                <Variant mode="AMBIENT" target="alpha" value="0"/>
                <Font family="SYNC_TO_DEVICE" size="128" weight="LIGHT" color="#ffe8ebef"/>
            </TimeText>
            <TimeText format="hh" hourFormat="24" align="END"
                      x="0" y="0" width="212" height="140" alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255"/>
                <Font family="SYNC_TO_DEVICE" size="128" weight="THIN" color="#ffb9bfc9"/>
            </TimeText>

            <TimeText format="mm" hourFormat="24" align="START"
                      x="238" y="0" width="212" height="140" alpha="255">
                <Variant mode="AMBIENT" target="alpha" value="0"/>
                <Font family="SYNC_TO_DEVICE" size="128" weight="LIGHT" color="#ffe8ebef"/>
            </TimeText>
            <TimeText format="mm" hourFormat="24" align="START"
                      x="238" y="0" width="212" height="140" alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255"/>
                <Font family="SYNC_TO_DEVICE" size="128" weight="THIN" color="#ffb9bfc9"/>
            </TimeText>
        </DigitalClock>

        <!--
          The bottom row is three cells: a battery slot, the current
          temperature, and a heart rate slot. The two outer cells are swappable
          complications; the temperature between them is native, so it needs no
          slot of its own.

          Letting the system providers supply the icon keeps the glyphs
          monochrome: a literal heart character gets picked up by the colour
          emoji font and renders as a red blob.

          The value text sits at a fixed y in both slots, outside the icon
          Condition, so the two numbers stay on one baseline whether or not a
          given provider supplies an icon.
        -->
        <ComplicationSlot x="71" y="318" width="96" height="62" slotId="0"
                          name="left_complication"
                          displayName="left_complication_label"
                          supportedTypes="SHORT_TEXT EMPTY">
            <Variant mode="AMBIENT" target="alpha" value="130"/>
            <DefaultProviderPolicy defaultSystemProvider="WATCH_BATTERY"
                                   defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingRoundBox x="0" y="0" width="96" height="62"
                              outlinePadding="2.0" cornerRadius="16"/>
            <Complication type="SHORT_TEXT">
                <Condition>
                    <Expressions>
                        <Expression name="left_icon"><![CDATA[[COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                    </Expressions>
                    <Compare expression="left_icon">
                        <PartImage x="35" y="0" width="26" height="26" tintColor="#ffdde1e7">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
                        </PartImage>
                    </Compare>
                </Condition>
                <PartText x="0" y="28" width="96" height="34">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="29" weight="BOLD" color="#ffffffff">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]"/>
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!--
          Heart rate, through a complication slot rather than the [HEART_RATE]
          data source: that source reads 0 on the emulator even with
          BODY_SENSORS granted, while the HEART_RATE complication provider
          returns live values.

          This slot always draws ic_heart.png rather than the provider's own
          icon, because tintColor MULTIPLIES rather than replaces: the white
          battery mark in the left slot comes out grey, but Google's heart-rate
          icon is already red, so red x grey lands on a dark red (measured
          116,40,45 on the watch) and there is no way to grey it. Our own white
          asset multiplies cleanly to the palette grey.

          The cost is that the heart stays put if this slot is pointed at some
          other provider.
        -->
        <ComplicationSlot x="283" y="318" width="96" height="62" slotId="1"
                          name="right_complication"
                          displayName="right_complication_label"
                          supportedTypes="SHORT_TEXT EMPTY">
            <Variant mode="AMBIENT" target="alpha" value="130"/>
            <DefaultProviderPolicy defaultSystemProvider="HEART_RATE"
                                   defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingRoundBox x="0" y="0" width="96" height="62"
                              outlinePadding="2.0" cornerRadius="16"/>
            <Complication type="SHORT_TEXT">
                <PartImage x="35" y="0" width="26" height="26" tintColor="#ffdde1e7">
                    <Image resource="ic_heart"/>
                </PartImage>
                <PartText x="0" y="28" width="96" height="34">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="29" weight="BOLD" color="#ffffffff">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]"/>
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!--
          The weather cell is a Group so a single <Launch> covers the icon,
          the temperature and the gap between them, rather than needing one
          per part with dead space in between. Child coordinates are relative
          to the group origin at (177, 318).

          There is no WEATHER system shortcut the way there is for CALENDAR,
          so the target is a package name. That pins this to the Pixel weather
          app; on another vendor's watch the tap would do nothing.
        -->
        <Group x="177" y="318" width="96" height="62" name="weather_cell">
            <Launch target="com.google.android.apps.weather"/>
            <!--
              Current temperature, centre cell of the bottom row.

              WFF exposes weather natively from v2, so this needs no complication
              slot and no permission in the manifest: the runtime supplies the data
              from whatever weather source the watch already has. IS_AVAILABLE
              guards it, since the reading is empty until that source has fetched.

              Sits on the same baseline as the two flanking values, so the three
              numbers line up.
            -->
            <Condition>
                <Expressions>
                    <Expression name="weatherReady"><![CDATA[[WEATHER.IS_AVAILABLE]]]></Expression>
                </Expressions>
                <Compare expression="weatherReady">
                    <!-- Day or night glyph set, chosen by IS_DAY so CLEAR reads as
                         a sun by day and a moon by night. -->
                    <Condition>
                        <Expressions>
                            <Expression name="isDay"><![CDATA[[WEATHER.IS_DAY]]]></Expression>
                        </Expressions>
                        <Compare expression="isDay">
                    <PartText x="0" y="0" width="96" height="26"
                              name="wx_icon_day" tintColor="#ffdde1e7">
                        <Variant mode="AMBIENT" target="alpha" value="130"/>
                        <Text align="CENTER">
                            <BitmapFont family="wx_day" size="26">
                                <Template><![CDATA[%s]]>
                                    <Parameter expression="[WEATHER.CONDITION] &lt;= 15 ? [WEATHER.CONDITION] : 0"/>
                                </Template>
                            </BitmapFont>
                        </Text>
                    </PartText>
                        </Compare>
                        <Default>
                            <!-- CLEAR (1) and SUNNY (8) at night mean an
                                 unobscured sky, so show the actual lunar phase
                                 rather than a generic crescent. Every other
                                 condition falls through to the weather glyph. -->
                            <Condition>
                                <Expressions>
                                    <Expression name="clearNight"><![CDATA[[WEATHER.CONDITION] == 1 || [WEATHER.CONDITION] == 8]]></Expression>
                                </Expressions>
                                <Compare expression="clearNight">
                    <PartText x="0" y="0" width="96" height="26"
                              name="moon_icon" tintColor="#ffdde1e7">
                        <Variant mode="AMBIENT" target="alpha" value="130"/>
                        <Text align="CENTER">
                            <BitmapFont family="moon_phases" size="26">
                                <Template><![CDATA[%s]]>
                                    <Parameter expression="[MOON_PHASE_TYPE]"/>
                                </Template>
                            </BitmapFont>
                        </Text>
                    </PartText>
                                </Compare>
                                <Default>
                    <PartText x="0" y="0" width="96" height="26"
                              name="wx_icon_night" tintColor="#ffdde1e7">
                        <Variant mode="AMBIENT" target="alpha" value="130"/>
                        <Text align="CENTER">
                            <BitmapFont family="wx_night" size="26">
                                <Template><![CDATA[%s]]>
                                    <Parameter expression="[WEATHER.CONDITION] &lt;= 15 ? [WEATHER.CONDITION] : 0"/>
                                </Template>
                            </BitmapFont>
                        </Text>
                    </PartText>
                                </Default>
                            </Condition>
                        </Default>
                    </Condition>
                    <PartText x="0" y="28" width="96" height="34" name="weather">
                        <Variant mode="AMBIENT" target="alpha" value="130"/>
                        <Text align="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="29" weight="BOLD" color="#ffffffff">
                                <Template><![CDATA[%d°]]>
                                    <Parameter expression="[WEATHER.TEMPERATURE]"/>
                                </Template>
                            </Font>
                        </Text>
                    </PartText>
                </Compare>
                <Default>
                    <PartText x="0" y="28" width="96" height="34" name="weather_none">
                        <Variant mode="AMBIENT" target="alpha" value="100"/>
                        <Text align="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="29" weight="BOLD" color="#ff5c636c">
                                <Template><![CDATA[--]]></Template>
                            </Font>
                        </Text>
                    </PartText>
                </Default>
            </Condition>
        </Group>

    </Scene>
</WatchFace>
